[Unit]
Description=uni-mail dispatcher: deliver mail events to webhooks and commands
Documentation=https://github.com/JuanDelPueblo/uni-mail
Wants=uni-mail.service network-online.target
After=uni-mail.service network-online.target

[Service]
Environment=UNI_MAIL_LOG_LEVEL=INFO
ExecStart=/opt/uni-mail/bin/uni-mail --config /etc/uni-mail/config.json dispatch run
# A dedicated user with no login. Its group membership in uni-mail gives it
# the daemon socket and the config file, not the tokens (mode 0600). The
# command destinations run as this user too: to run `nanobot trigger`, use a
# drop-in with User= and Group= of the Nanobot user (integrations/nanobot).
User=uni-mail-dispatch
Group=uni-mail-dispatch
SupplementaryGroups=uni-mail
StateDirectory=uni-mail-dispatch
StateDirectoryMode=0700
Restart=always
RestartSec=15
# A stop waits for a running command or request; the timeout of a destination is at most one hour.
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
# Command destinations may need more: for example ReadWritePaths= for the
# Nanobot workspace, or ProtectHome=false (the default here) for a program in
# a home directory. Webhook-only setups can add ProtectHome=true.

[Install]
WantedBy=multi-user.target
