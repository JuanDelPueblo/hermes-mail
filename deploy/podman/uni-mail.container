# The daemon in a rootless container: ~/.config/containers/systemd/uni-mail.container
# Build the image first (podman build -t localhost/uni-mail:latest .), see docs/CONTAINER.md.
[Unit]
Description=uni-mail daemon (container): IMAP index, socket API and event log
Documentation=https://github.com/JuanDelPueblo/uni-mail/blob/main/docs/CONTAINER.md

[Container]
ContainerName=uni-mail
Image=localhost/uni-mail:latest
Exec=uni-maild --config /etc/uni-mail/config.json
# The image user 10001 is your own user on the host: the config you own is
# readable, and the files in the volumes belong to you.
UserNS=keep-id:uid=10001,gid=10001
# The config directory, read-only. "z": shared with the other uni-mail containers.
Volume=%h/.config/uni-mail:/etc/uni-mail:ro,z
Volume=uni-mail-state.volume:/var/lib/uni-mail
# The socket, shared with the dispatcher and the MCP server.
Volume=uni-mail-run.volume:/run/uni-mail
Environment=UNI_MAIL_LOG_LEVEL=INFO
# Outbound IMAP and OAuth only; nothing listens on the network.
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
# New files are private to the user, as with UMask=0077 in the native units.
PodmanArgs=--umask=0077
HealthCmd=uni-mail status
HealthInterval=5m
HealthStartPeriod=1m

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=300

[Install]
WantedBy=default.target
