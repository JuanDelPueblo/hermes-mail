# The dispatcher in a rootless container: ~/.config/containers/systemd/uni-mail-dispatch.container
[Unit]
Description=uni-mail dispatcher (container): deliver mail events to webhooks
Documentation=https://github.com/JuanDelPueblo/uni-mail/blob/main/docs/CONTAINER.md
Wants=uni-mail.service
After=uni-mail.service

[Container]
ContainerName=uni-mail-dispatch
Image=localhost/uni-mail:latest
Exec=uni-mail --config /etc/uni-mail/config.json dispatch run
UserNS=keep-id:uid=10001,gid=10001
Volume=%h/.config/uni-mail:/etc/uni-mail:ro,z
Volume=uni-mail-dispatch.volume:/var/lib/uni-mail-dispatch
Volume=uni-mail-run.volume:/run/uni-mail
Environment=UNI_MAIL_LOG_LEVEL=INFO
# The host network, so that a webhook can reach a receiver on the host's
# loopback (for example an agent's webhook receiver on 127.0.0.1).
# For webhooks to other hosts only, remove this line.
Network=host
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
# New files are private to the user, as with UMask=0077 in the native units.
PodmanArgs=--umask=0077

[Service]
Restart=always
RestartSec=15
# A stop waits for a running request; see the destination timeouts.
TimeoutStopSec=90
TimeoutStartSec=300

[Install]
WantedBy=default.target
