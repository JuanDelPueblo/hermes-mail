[Unit]
Description=uni-mail daemon: IMAP index, socket API and event log
Documentation=https://github.com/JuanDelPueblo/uni-mail
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/uni-mail
# Never sync the same accounts next to the daemon this one replaced (docs/MIGRATION.md).
Conflicts=hermes-mail.service hermes-mail-notify.service

[Service]
Environment=UNI_MAIL_LOG_LEVEL=INFO
ExecStart=/opt/uni-mail/bin/uni-maild --config /etc/uni-mail/config.json
User=uni-mail
Group=uni-mail
RuntimeDirectory=uni-mail
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=10
UMask=0027
ReadWritePaths=/var/lib/uni-mail /var/lib/uni-mail/exports
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
